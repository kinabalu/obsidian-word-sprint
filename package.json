{
	"name": "obsidian-word-sprint",
	"version": "0.4.0",
	"description": "Timed writing sprints with stats, goals, and nudges to keep you writing.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"test": "jest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Andrew Lombardi <andrew@mysticcoders.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kinabalu/obsidian-word-sprint.git"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^0.14.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.4",
		"@types/numeral": "^2.0.5",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"builtin-modules": "^5.4.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jest": "^30.5.2",
		"obsidian": "^1.13.1",
		"ts-jest": "^29.4.14",
		"tslib": "^2.8.1",
		"typescript": "~5.9",
		"typescript-eslint": "^8.71.1"
	},
	"dependencies": {
		"numeral": "^2.0.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"jest": {
		"transform": {
			"^.+\\.tsx?$": [
				"ts-jest",
				{
					"tsconfig": {
						"esModuleInterop": true
					}
				}
			]
		},
		"moduleNameMapper": {
			"src/(.*)": "<rootDir>/src/$1"
		},
		"moduleFileExtensions": [
			"js",
			"ts"
		]
	}
}
